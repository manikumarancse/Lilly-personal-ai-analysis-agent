{
  "manifest_version": 3,
  "name": "Lilly — Personal AI Analysis Agent",
  "version": "0.10.0",
  "description": "Monitor TradingView chart context, live prices, structured OHLC data, session history and alerts.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://*.tradingview.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lilly",
    "default_popup": "popup.html"
  }
}
